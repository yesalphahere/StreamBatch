{
  "manifest_version": 3,
  "name": "StreamBatch Download Manager",
  "version": "1.0.0",
  "description": "Send media and playlist URLs directly into StreamBatch desktop download manager.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9654/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
